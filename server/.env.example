# Puerto del servidor
PORT=3001

# LLM (DeepSeek, compatible con la API de OpenAI)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=45000

# Mapas: openrouteservice | mapbox | google
MAPS_API_KEY=
MAPS_PROVIDER=openrouteservice
MAPS_BASE_URL=https://api.openrouteservice.org
MAPS_TIMEOUT_MS=15000

# Centro usado cuando no hay clave de mapas (modo mock)
MOCK_CENTER_LAT=40.4168
MOCK_CENTER_LNG=-3.7038

# Ajustes del planificador
DEFAULT_VISIT_MINUTES=60
DEFAULT_MEAL_MINUTES=60
TRAVEL_BUFFER_MINUTES=5
MAX_EXTRA_STOPS=5

# Distancia máxima permitida en metros entre paradas consecutivas
MAX_DISTANCE_METERS=600000
